{
  "name": "recodex",
  "version": "0.0.1-alpha",
  "description": "A local desktop workspace for an agent harness",
  "author": "potistudio <potistudio@proton.me>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --config svelte.config.js --tsconfig ./tsconfig.json && biome check .",
    "check:watch": "svelte-check --config svelte.config.js --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "vitest run web/src/lib/conversation.test.ts web/src/lib/working.test.ts web/src/lib/usage.test.ts web/src/lib/motion.test.ts",
    "test:e2e": "playwright test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "pull:refs": "node scripts/pull-refs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-icons/fluent": "^2.0.5",
    "@iconify/svelte": "^5.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "hyperellipse": "1.0.5",
    "marked": "^18.0.11",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.4.1",
    "bits-ui": "^2.19.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  }
}
