{
  "name": "recodex",
  "version": "0.0.1-alpha",
  "description": "My own Codex App",
  "author": "potistudio <potistudio@proton.me>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && biome check .",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "node scripts/with-codex.mjs tauri",
    "test": "vitest run src/lib/conversation.test.ts src/lib/working.test.ts",
    "test:e2e": "playwright test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test:server": "node scripts/with-codex.mjs cargo test --manifest-path src-tauri/Cargo.toml --lib -- --ignored"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.41.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "marked": "^18.0.11",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@internationalized/date": "^3.12.4",
    "@openai/codex": "0.153.4",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.4.1",
    "bits-ui": "^2.19.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  }
}
